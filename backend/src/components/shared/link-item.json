{
  "collectionName": "components_shared_link_items",
  "info": {
    "displayName": "Important Links",
    "icon": "bulletList"
  },
  "options": {},
  "attributes": {
    "Label": {
      "type": "string",
      "required": true
    },
    "URL": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Link_message_require"
            },
            false
          ]
        }
      }
    },
    "Link_message_require": {
      "type": "boolean",
      "default": false
    },
    "Link_message": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Link_message_require"
            },
            true
          ]
        }
      }
    },
    "Need_PDF_upload": {
      "type": "boolean",
      "default": false
    },
    "Upload_PDF": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Need_PDF_upload"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  },
  "config": {}
}
