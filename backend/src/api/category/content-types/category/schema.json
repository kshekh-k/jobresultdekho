{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category",
    "description": "Categories with parent-child relationships"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "order": {
      "type": "integer"
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "category"
    },
    "admit_cards": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::admit-card.admit-card",
      "mappedBy": "category"
    },
    "results": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::result.result",
      "mappedBy": "category"
    },
    "admissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::admission.admission",
      "mappedBy": "category"
    },
    "syllabus": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::syllabus.syllabus",
      "mappedBy": "category"
    },
    "answer_keys": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer-key.answer-key",
      "mappedBy": "category"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "parent"
    },
    "SEO": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
