{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "short_description": {
      "type": "blocks"
    },
    "content": {
      "type": "blocks"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "jobs"
    },
    "department": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::department.department"
    },
    "last_date": {
      "type": "date",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Start_date"
            },
            true
          ]
        }
      }
    },
    "important_links": {
      "type": "component",
      "component": "shared.link-item",
      "repeatable": true,
      "min": 0
    },
    "Link_not_available": {
      "type": "boolean",
      "default": false
    },
    "reference_url": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Link_not_available"
            },
            false
          ]
        }
      }
    },
    "Link_Activate_Message": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Link_not_available"
            },
            true
          ]
        }
      }
    },
    "FAQs": {
      "type": "component",
      "component": "shared.faq",
      "repeatable": true
    },
    "total_posts": {
      "type": "integer"
    },
    "job_disclaimer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::job-disclaimer.job-disclaimer"
    },
    "important_dates": {
      "type": "component",
      "component": "shared.important-dates",
      "repeatable": false
    },
    "application_fee": {
      "type": "component",
      "component": "shared.application-fee",
      "repeatable": false
    },
    "eligiblity_criterea": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::eligiblity-criterea.eligiblity-criterea"
    },
    "stage": {
      "type": "enumeration",
      "default": "Job",
      "enum": [
        "Job",
        "Admit Card",
        "Result",
        "Answer Key",
        "Waiting List",
        "Archive Job"
      ]
    },
    "SEO": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "high_alert": {
      "type": "boolean",
      "default": false
    },
    "hot_post": {
      "type": "boolean",
      "default": false
    },
    "banner_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Fees_of_application": {
      "type": "component",
      "component": "shared.fees",
      "repeatable": true
    },
    "Apply_date_Start_message": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "Start_date"
            },
            false
          ]
        }
      }
    },
    "Start_date": {
      "type": "boolean",
      "default": true
    }
  }
}
