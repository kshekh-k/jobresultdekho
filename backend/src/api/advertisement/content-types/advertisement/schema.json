{
  "kind": "collectionType",
  "collectionName": "advertisements",
  "info": {
    "singularName": "advertisement",
    "pluralName": "advertisements",
    "displayName": "Advertisement",
    "description": "Manage native and Google AdSense ads shown across the site"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "adType": {
      "type": "enumeration",
      "enum": ["native", "google_adsense"],
      "required": true,
      "default": "native"
    },
    "adLink": {
      "type": "string"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": true
    },
    "imageMode": {
      "type": "enumeration",
      "enum": ["single", "responsive"],
      "default": "responsive"
    },
    "singleImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "desktopImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "googleAdSlot": {
      "type": "string"
    },
    "googleAdFormat": {
      "type": "enumeration",
      "enum": ["auto", "rectangle", "banner", "vertical", "horizontal"],
      "default": "auto"
    },
    "googleAdClient": {
      "type": "string"
    },
    "impressions": {
      "type": "integer",
      "default": 0
    },
    "clicks": {
      "type": "integer",
      "default": 0
    }
  }
}
