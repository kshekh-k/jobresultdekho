# ===============================
# 🌐 Project Configuration
# ===============================
PROJECT_NAME=xyresults
NODE_ENV=production

# ===============================
# 🧱 Database (PostgreSQL)
# ===============================
POSTGRES_USER=xyresults_user
POSTGRES_PASSWORD=xyresults_pass
POSTGRES_DB=xyresults
POSTGRES_PORT=5432

# ===============================
# 🔥 Redis
# ===============================
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# ===============================
# 🚀 Strapi
# ===============================
STRAPI_PORT=1337

# ===============================
# 💻 Frontend (Svelte)
# ===============================
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0
# Local development
#API_URL=http://127.0.0.1:1337/api
# In production (Caddy reverse proxy)
# API_URL=https://api.jobresultdekho.com/api

# ===============================
# ⚙️ Docker Compose Settings
# ===============================
COMPOSE_PROJECT_NAME=xyresults

# ===============================
# 🌍 Domains (for Caddy)
# ===============================
DOMAIN=jobresultdekho.com
API_DOMAIN=api.jobresultdekho.com/api
EMAIL=admin@jobresultdekho.com
