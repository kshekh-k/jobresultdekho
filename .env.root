# XYResults Environment Configuration
POSTGRES_USER=xyresults_user
POSTGRES_PASSWORD=xyresults_pass
POSTGRES_DB=xyresults
POSTGRES_PORT=5432

# Strapi
STRAPI_PORT=1337

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# Project Settings
PROJECT_NAME=xyresults
NODE_ENV=production

# Varnish
VARNISH_PORT=8080
VARNISH_MEMORY=256M
VARNISH_BACKEND_HOST=strapi
VARNISH_BACKEND_PORT=1337

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SERVER_NAME=localhost

# Frontend
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0
VITE_API_URL=http://localhost:${NGINX_PORT}/api

# Docker Compose Settings
COMPOSE_PROJECT_NAME=xyresults