# ========== LOCAL (Dev) ==========
:80 {
    encode gzip
    reverse_proxy frontend:3000
}

:8080 {
    encode gzip
    reverse_proxy strapi:1337
}

# ========== PRODUCTION ==========
jobresultdekho.com {
    encode gzip
    reverse_proxy frontend:3000
}

api.jobresultdekho.com {
    encode gzip

    request_body {
        max_size 100MB
    }

    reverse_proxy strapi:1337 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Optional: redirect www → non-www
www.jobresultdekho.com {
    redir https://jobresultdekho.com{uri}
}
